# Telegram Affiliate Automation — .env template
# Copy this file to .env and fill in your real values

BOT_TOKEN=your_bot_token_from_botfather
CHANNEL_ID=@your_channel_username
API_ID=your_api_id_from_my_telegram_org
API_HASH=your_api_hash
TELEGRAM_SESSION_1=your_telethon_session_string
ADMIN_CHAT_ID=your_telegram_user_id
BOT_USERNAME=YourBotUsername
CLICK_TRACKER_URL=https://your-netlify-site.netlify.app

# Netlify (for CI/CD deployment — set in GitHub Secrets, not .env)
# NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token
# NETLIFY_SITE_ID=your_netlify_site_id

# Amazon affiliate tag (used by group_poster.py and go.js)
# AFFILIATE_ID_IN=your-tag-21

# Referral rewards (optional — have defaults)
# REFERRAL_REWARD_BASE=10
# REFERRAL_TIER_1_THRESHOLD=5
# REFERRAL_TIER_2_THRESHOLD=10
